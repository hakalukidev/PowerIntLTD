# Local E2E environment: copy to .env.test (gitignored) and run `npm run test:e2e:local`.
# Everything here points at the Firebase Emulator Suite; nothing reaches the live project.
# A `demo-` project id makes the emulators refuse to fall through to real Firebase services.

NEXT_PUBLIC_FIREBASE_EMULATOR=1
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-powerint
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-powerint.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-powerint.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=0
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-powerint-default-rtdb
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000

# Read by the Admin SDK on the server.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
FIREBASE_PROJECT_ID=demo-powerint
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# No WhatsApp messages from test runs.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# The E2E dev server gets its own port and build folder, so it never reuses `npm run dev`.
NEXT_DIST_DIR=.next-e2e
E2E_BASE_URL=http://localhost:3100

# Test logins created by scripts/seed-emulator.mjs. They exist only in the Auth emulator.
E2E_ADMIN_EMAIL=e2e-admin@powerint.test
E2E_ADMIN_PASSWORD=e2e-admin-pass
E2E_AUTHORIZER_EMAIL=e2e-authorizer@powerint.test
E2E_AUTHORIZER_PASSWORD=e2e-authorizer-pass
E2E_CHAIRMAN_EMAIL=e2e-chairman@powerint.test
E2E_CHAIRMAN_PASSWORD=e2e-chairman-pass

# Screenshots from emulator runs stay out of the tracked client-feedback folder.
EVIDENCE_DIR=test-results/emulator-evidence
